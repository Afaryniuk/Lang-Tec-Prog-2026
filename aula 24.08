#include <stdio.h>
#include <stdlib.h>

/* run this program using the console pauser or add your own getch, system("pause") or input loop */
int main(int argc, char *argv[]) {
	
	int a,b,c;
	int resultado;
	
	printf("insira os valores de A, B, C: ");
	scanf("%d %d %d", &a, &b,&c );
	
	if (a>b){
		resultado = a;
	}else{
		resultado = b;
	}
		if (resultado>c){
		resultado = resultado;
	}else{
		resultado = c;
	}
	
	printf("%d eh o maior", resultado);

	
	return 0;
}
