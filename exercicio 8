#include <stdio.h>
#include <stdlib.h>
#include <math.h>

int main(int argc, char *argv[]) {

	int x1, x2, y1, y2, p1, p2;
	float dis;
	
	printf("insira o valor do par ordenado (x1,y1): ");
    scanf("%d",&x1);
    scanf("%d",&y1);
    
    printf("insira o valor do par ordenado (x2,y2): ");
    scanf("%d",&x2);
    scanf("%d",&y2);
    
    p1 = pow(x2-x1,2);
    p2 = pow(y2-y1,2);
    
    dis = sqrt(p1+p2);
    
    printf("A distancia entre P1 e P2 = %f", dis);
    return 0;
}
